<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_background"
    android:layout_marginVertical="6dp"
    android:padding="12dp"
    android:elevation="2dp">

    <ImageView
        android:id="@+id/siteImage"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:scaleType="centerCrop"
        android:background="@drawable/card_background"
        android:contentDescription="Plant Image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/deleteButton"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/delete"
        android:contentDescription="Delete"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="4dp"/>

    <ImageView
        android:id="@+id/editButton"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/edit"
        android:contentDescription="Edit"
        app:layout_constraintBottom_toBottomOf="@id/siteImage"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:padding="4dp" />

    <LinearLayout
        android:id="@+id/editPopup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@drawable/card_background"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/siteInfo"
        app:layout_constraintStart_toStartOf="@id/siteName"
        app:layout_constraintEnd_toEndOf="@id/siteName"
        android:layout_marginTop="8dp">

        <EditText
            android:id="@+id/editPlantNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Custom name"
            android:background="@android:drawable/edit_text"
            android:padding="8dp" />

        <AutoCompleteTextView
            android:id="@+id/editSiteInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Select site"
            android:background="@android:drawable/edit_text"
            android:padding="8dp"
            android:layout_marginTop="8dp"
            android:inputType="none"
            android:focusable="false" />

        <Button
            android:id="@+id/saveEditButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:backgroundTint="#175202"
            android:textColor="@android:color/white" />
    </LinearLayout>


    <TextView
        android:id="@+id/siteName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Plant Name Long Long Long Long"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/siteImage"
        app:layout_constraintEnd_toStartOf="@id/deleteButton"
        app:layout_constraintHorizontal_bias="0"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp" />

    <TextView
        android:id="@+id/siteInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Watering every ... days\nAdded: 2024-04-10"
        android:textSize="14sp"
        android:textColor="#555555"
        app:layout_constraintTop_toBottomOf="@id/siteName"
        app:layout_constraintStart_toStartOf="@id/siteName"
        app:layout_constraintEnd_toEndOf="@id/siteName"
        android:layout_marginTop="21dp" />
</androidx.constraintlayout.widget.ConstraintLayout>